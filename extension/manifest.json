{
  "manifest_version": 3,
  "name": "ELI5 This Page",
  "version": "1.0.0",
  "description": "Explain the page you're on \u2014 or anything you highlight \u2014 at the reading level you choose.",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": ["https://eli5-extension.onrender.com"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
